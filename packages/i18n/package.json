{
    "name": "@spfn/i18n",
    "version": "0.2.0-beta.5",
    "description": "Small, content-agnostic internationalization runtime for SPFN and React applications.",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": "./dist/server.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.js"
        },
        "./routing": {
            "types": "./dist/routing.d.ts",
            "import": "./dist/routing.js",
            "require": "./dist/routing.js"
        },
        "./next": {
            "types": "./dist/next.d.ts",
            "import": "./dist/next.js",
            "require": "./dist/next.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "pnpm check:circular && tsup && tsup --config tsup.client.config.ts",
        "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
        "prepublishOnly": "pnpm type-check && pnpm build && pnpm test",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "check:circular": "madge --circular --extensions ts,tsx src/",
        "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
        "publish:beta": "node ../../scripts/publish-package.mjs beta",
        "publish:latest": "node ../../scripts/publish-package.mjs latest"
    },
    "keywords": [
        "spfn",
        "i18n",
        "internationalization",
        "localization",
        "react",
        "nextjs",
        "typescript"
    ],
    "author": "Ray Im <rayim@fxy.global>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fxylabs/spfn.git",
        "directory": "packages/i18n"
    },
    "bugs": {
        "url": "https://github.com/fxylabs/spfn/issues"
    },
    "homepage": "https://github.com/fxylabs/spfn/tree/main/packages/i18n#readme",
    "engines": {
        "node": ">=20.0.0"
    },
    "peerDependencies": {
        "next": "^16.3.3",
        "react": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "madge": "^8.0.0",
        "next": "^16.3.3",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.6"
    },
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    }
}
