{
  "name": "@spfn/storage",
  "version": "0.3.0-beta.2",
  "type": "module",
  "description": "Provider-agnostic object storage (S3/GCS/local) with upload, streaming download, server-side copy, prefix listing, and deletion APIs.",
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    },
    "./server/*": {
      "types": "./dist/server/*.d.ts",
      "import": "./dist/server/*.js",
      "require": "./dist/server/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "pnpm check:circular && tsup && pnpm check:bundle",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check:circular": "madge --circular --extensions ts src/",
    "check:bundle": "node scripts/check-bundle.mjs",
    "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
    "publish:beta": "node ../../scripts/publish-package.mjs beta",
    "publish:latest": "node ../../scripts/publish-package.mjs latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1022.0"
  },
  "optionalDependencies": {
    "@google-cloud/storage": "^7.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "madge": "^8.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxylabs/spfn.git",
    "directory": "packages/storage"
  }
}
