{
  "name": "@spfn/pages-next",
  "version": "0.1.0-beta.8",
  "type": "module",
  "description": "Next.js integration for @spfn/pages — layouts, catch-all route helpers, static export support, and the sync CLI for self-deploying a site repo to Vercel/Cloudflare or SPFN hosting.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js",
      "require": "./dist/dev.js"
    },
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js",
      "require": "./dist/hosted.js"
    }
  },
  "bin": {
    "spfn-pages": "bin/spfn-pages.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "pnpm check:circular && tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
    "publish:beta": "node ../../scripts/publish-package.mjs beta",
    "publish:latest": "node ../../scripts/publish-package.mjs latest"
  },
  "peerDependencies": {
    "@spfn/pages": ">=0.1.0-beta.1",
    "next": "^16.3.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@spfn/pages": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "madge": "^8.0.0",
    "next": "^16.3.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxylabs/spfn.git",
    "directory": "packages/pages-next"
  }
}
