{
  "name": "spfn",
  "version": "0.3.0-beta.1",
  "description": "Scaffold a full-stack TypeScript backend onto a Next.js app built with an AI coding agent: auth, database, typed routes and codegen, one fixed vertical slice per feature",
  "type": "module",
  "bin": {
    "spfn": "bin/spfn.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-templates.js",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
    "publish:beta": "node ../../scripts/publish-package.mjs beta",
    "publish:latest": "node ../../scripts/publish-package.mjs latest"
  },
  "keywords": [
    "spfn",
    "cli",
    "nextjs",
    "backend",
    "framework",
    "generator",
    "crud-generator",
    "scaffolding",
    "boilerplate",
    "dev-tools",
    "typescript",
    "type-safe",
    "full-stack-framework",
    "ai-coding-agent",
    "claude-code"
  ],
  "author": "Ray Im <rayim@fxy.global>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxylabs/spfn.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://git.superfunction.xyz/api/packages/superfunction/npm/"
  },
  "bugs": {
    "url": "https://github.com/fxylabs/spfn/issues"
  },
  "homepage": "https://github.com/fxylabs/spfn/tree/main/packages/cli#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@spfn/core": ">=0.3.0-beta.1 <0.4.0",
    "typescript": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.0",
    "prompts": "^2.4.2",
    "tsup": "^8.5.0",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@spfn/core": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/prompts": "^2.4.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^4.0.6"
  }
}
