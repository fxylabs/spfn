{
    "name": "@spfn/core",
    "version": "0.3.0-beta.2",
    "description": "Full-stack TypeScript backend for Next.js: file-based typed routes, Drizzle entities and repositories, PostgreSQL transactions and a generated end-to-end client, in one fixed vertical slice per feature",
    "type": "module",
    "exports": {
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js",
            "require": "./dist/client/index.js"
        },
        "./nextjs": {
            "types": "./dist/nextjs/index.d.ts",
            "import": "./dist/nextjs/index.js",
            "require": "./dist/nextjs/index.js"
        },
        "./nextjs/server": {
            "types": "./dist/nextjs/server.d.ts",
            "import": "./dist/nextjs/server.js",
            "require": "./dist/nextjs/server.js"
        },
        "./route": {
            "types": "./dist/route/index.d.ts",
            "import": "./dist/route/index.js",
            "require": "./dist/route/index.js"
        },
        "./route/types": {
            "types": "./dist/route/types.d.ts",
            "import": "./dist/route/types.js",
            "require": "./dist/route/types.js"
        },
        "./db": {
            "types": "./dist/db/index.d.ts",
            "import": "./dist/db/index.js",
            "require": "./dist/db/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js",
            "require": "./dist/server/index.js"
        },
        "./errors": {
            "types": "./dist/errors/index.d.ts",
            "import": "./dist/errors/index.js",
            "require": "./dist/errors/index.js"
        },
        "./middleware": {
            "types": "./dist/middleware/index.d.ts",
            "import": "./dist/middleware/index.js",
            "require": "./dist/middleware/index.js"
        },
        "./security": {
            "types": "./dist/security/index.d.ts",
            "import": "./dist/security/index.js",
            "require": "./dist/security/index.js"
        },
        "./authz": {
            "types": "./dist/authz/index.d.ts",
            "import": "./dist/authz/index.js",
            "require": "./dist/authz/index.js"
        },
        "./cache": {
            "types": "./dist/cache/index.d.ts",
            "import": "./dist/cache/index.js",
            "require": "./dist/cache/index.js"
        },
        "./codegen": {
            "types": "./dist/codegen/index.d.ts",
            "import": "./dist/codegen/index.js",
            "require": "./dist/codegen/index.js"
        },
        "./contract": {
            "types": "./dist/contract/index.d.ts",
            "import": "./dist/contract/index.js",
            "require": "./dist/contract/index.js"
        },
        "./ops": {
            "types": "./dist/ops/index.d.ts",
            "import": "./dist/ops/index.js",
            "require": "./dist/ops/index.js"
        },
        "./env": {
            "types": "./dist/env/index.d.ts",
            "import": "./dist/env/index.js",
            "require": "./dist/env/index.js"
        },
        "./env/loader": {
            "types": "./dist/env/loader.d.ts",
            "import": "./dist/env/loader.js",
            "require": "./dist/env/loader.js"
        },
        "./logger": {
            "types": "./dist/logger/index.d.ts",
            "import": "./dist/logger/index.js",
            "require": "./dist/logger/index.js"
        },
        "./config": {
            "types": "./dist/config/index.d.ts",
            "import": "./dist/config/index.js",
            "require": "./dist/config/index.js"
        },
        "./job": {
            "types": "./dist/job/index.d.ts",
            "import": "./dist/job/index.js",
            "require": "./dist/job/index.js"
        },
        "./event": {
            "types": "./dist/event/index.d.ts",
            "import": "./dist/event/index.js",
            "require": "./dist/event/index.js"
        },
        "./event/sse": {
            "types": "./dist/event/sse/index.d.ts",
            "import": "./dist/event/sse/index.js",
            "require": "./dist/event/sse/index.js"
        },
        "./event/sse/client": {
            "types": "./dist/event/sse/client.d.ts",
            "import": "./dist/event/sse/client.js",
            "require": "./dist/event/sse/client.js"
        },
        "./event/ws": {
            "types": "./dist/event/ws/index.d.ts",
            "import": "./dist/event/ws/index.js",
            "require": "./dist/event/ws/index.js"
        },
        "./event/ws/client": {
            "types": "./dist/event/ws/client.d.ts",
            "import": "./dist/event/ws/client.js",
            "require": "./dist/event/ws/client.js"
        }
    },
    "scripts": {
        "build": "pnpm check:circular && tsup",
        "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
        "dev": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:logger": "vitest run src/logger",
        "test:errors": "vitest run src/errors",
        "test:codegen": "vitest run src/codegen",
        "test:route": "vitest run src/route",
        "test:client": "vitest run src/client",
        "test:middleware": "vitest run src/middleware",
        "test:env": "vitest run src/env",
        "test:cache": "vitest run src/cache --config vitest.integration.config.ts",
        "test:db": "vitest run src/db --config vitest.integration.config.ts",
        "test:server": "vitest run src/server --config vitest.integration.config.ts",
        "check:circular": "madge --circular --extensions ts src/",
        "type-check": "tsc --noEmit",
        "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
        "publish:beta": "node ../../scripts/publish-package.mjs beta",
        "publish:latest": "node ../../scripts/publish-package.mjs latest"
    },
    "keywords": [
        "spfn",
        "nextjs",
        "backend",
        "framework",
        "typescript",
        "type-safe",
        "api",
        "rest-api",
        "crud",
        "database",
        "orm",
        "drizzle-orm",
        "postgres",
        "redis",
        "hono",
        "fullstack",
        "full-stack-framework",
        "ai-coding-agent",
        "claude-code",
        "file-based-routing",
        "transaction",
        "repository-pattern"
    ],
    "author": "Ray Im <rayim@fxy.global>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fxylabs/spfn.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/fxylabs/spfn/issues"
    },
    "homepage": "https://github.com/fxylabs/spfn/tree/main/packages/core#readme",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.5",
        "@sinclair/typebox": "^0.34.0",
        "chalk": "^5.6.2",
        "chokidar": "^4.0.3",
        "dotenv": "^17.2.3",
        "drizzle-typebox": "^0.3.3",
        "hono": "^4.12.34",
        "jiti": "^2.6.1",
        "micromatch": "^4.0.8",
        "pg-boss": "^11.1.2",
        "postgres": "^3.4.0",
        "typescript": "^5.3.3",
        "undici": "^7.29.0",
        "zod": "^4.4.3"
    },
    "optionalDependencies": {
        "ioredis": "^5.4.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@electric-sql/pglite": "0.5.4",
        "@types/micromatch": "^4.0.9",
        "@types/node": "^20.11.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.0.6",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "madge": "^8.0.0",
        "next": "^16.2.11",
        "tsup": "^8.5.0",
        "vitest": "^4.0.6"
    },
    "peerDependencies": {
        "drizzle-orm": ">=1.0.0-rc.4 <2",
        "next": "^16.2.11"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    }
}
