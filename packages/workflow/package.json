{
  "name": "@spfn/workflow",
    "version": "0.2.0-alpha.1",
  "description": "Lightweight workflow engine - Pipeline orchestration for @spfn/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
        "type-check": "tsc --noEmit",
        "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
        "publish:beta": "node ../../scripts/publish-package.mjs beta",
        "publish:latest": "node ../../scripts/publish-package.mjs latest"
  },
  "keywords": [
    "spfn",
    "workflow",
    "orchestration",
    "job",
    "pipeline",
    "typescript",
    "type-safe"
  ],
  "author": "Ray Im <rayim@fxy.global>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxylabs/spfn.git",
    "directory": "packages/workflow"
  },
  "bugs": {
    "url": "https://github.com/fxylabs/spfn/issues"
  },
  "homepage": "https://github.com/fxylabs/spfn/tree/main/packages/workflow#readme",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "peerDependencies": {
    "@spfn/core": ">=0.3.0-beta.1 <0.4.0",
    "drizzle-orm": ">=1.0.0-rc.4 <2"
  },
  "devDependencies": {
    "@spfn/core": "workspace:*",
    "@types/node": "^20.11.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.6"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "spfn": {
    "schemas": [
      "./dist/entities/*.js"
    ],
    "migrations": {
      "dir": "./migrations"
    }
  }
}
