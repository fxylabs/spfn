# TUNING — the one place for the heap and fan-out of the packages' build, read
# (sourced) by both builds Gitea Actions runs: check.yml's Build step and
# release.yml's Publish step, whose scripts/publish-changed.mjs builds every
# package. In a memory-limited container every Node process sizes its heap
# against that one limit; two builds at 3 GB each is what fit Woodpecker's
# 7 GiB pod (its publish step died with exit 137 without the cap). Unknown for
# the Gitea runner: change here.
BUILD_CONCURRENCY=2
BUILD_HEAP_MB=3072
