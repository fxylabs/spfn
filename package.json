{
  "name": "spfn",
  "private": true,
  "version": "0.1.0-alpha.26",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "setup:examples": "node scripts/seed-example-env.mjs",
    "check:versions": "node scripts/check-doc-versions.mjs",
    "check:exports": "node scripts/check-exports-require.mjs",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit --audit-level=high",
    "version:bump": "pnpm --filter \"./packages/*\" version"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "chalk": "^5.6.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^10.5.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.2",
    "ora": "^8.2.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.7",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "drizzle-typebox": "^0.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "next": "^16.4.1",
      "fast-xml-parser": "^5.10.1",
      "picomatch": "^2.3.2",
      "shell-quote": "^1.11.0",
      "jws": "^3.2.3",
      "lodash-es": "^4.18.1",
      "glob": "^10.5.0",
      "minimatch": "^9.0.7",
      "brace-expansion": "^2.1.7",
      "rollup": "^4.59.0",
      "yaml": "^2.8.3",
      "js-yaml@3": "^3.15.2",
      "nanoid@<3.3.18": "^3.3.18",
      "uuid@<11.1.1": "^11.1.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "browserslist@<4.28.7": "^4.28.7",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "sharp@<0.35.5": "^0.35.5"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
