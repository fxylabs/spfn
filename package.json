{
  "name": "spfn",
  "private": true,
  "version": "0.1.0-alpha.26",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo run clean",
    "check:versions": "node scripts/check-doc-versions.mjs",
    "check:exports": "node scripts/check-exports-require.mjs",
    "audit": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit --audit-level=high",
    "test:init": "node scripts/test-init.mjs",
    "publish:packages": "pnpm build --filter=\"!./apps/*\" && pnpm --filter \"./packages/*\" publish --tag alpha --access public",
    "publish:alpha": "pnpm publish:packages",
    "version:bump": "pnpm --filter \"./packages/*\" version"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "chalk": "^5.6.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "^10.5.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.2",
    "ora": "^8.2.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  },
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "drizzle-typebox": "^0.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.1",
      "react-dom": "^19.2.1",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "next": "^16.2.11",
      "fast-xml-parser": "^5.10.1",
      "picomatch": "^2.3.2",
      "shell-quote": "^1.8.4",
      "jws": "^3.2.3",
      "lodash-es": "^4.18.1",
      "glob": "^10.5.0",
      "minimatch": "^9.0.7",
      "brace-expansion": "^2.1.4",
      "rollup": "^4.59.0",
      "yaml": "^2.8.3",
      "js-yaml@3": "^3.15.1"
    }
  }
}
