# SPFN backend only, never loaded by Next.js. Copy this to .env.server.

# Environment
NODE_ENV=local

# Logging
SPFN_LOG_LEVEL=info

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://spfn:spfn@localhost:5432/spfn_dev
# DATABASE_OWNER_URL (the table owner, for spfn db push/migrate when the app runs as
# a second role) may go here for local development: only the spfn db commands that change
# the schema load it from this file; the server and every other command leave it out.
# In production give it only to the migrate job's environment.

# Cache - Redis/Valkey (optional)
CACHE_URL=redis://localhost:6379
